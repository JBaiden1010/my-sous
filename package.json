{
  "name": "my-sous",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "author": "Jeremy Baiden",
  "description": "My Sous: an AI cooking companion for students and beginners",
  "scripts": {
    "dev": "esbuild src/main.jsx --bundle --format=iife --jsx=automatic --loader:.js=jsx --define:process.env.NODE_ENV=\\\"development\\\" --outfile=www/app.js --servedir=www",
    "build": "esbuild src/main.jsx --bundle --format=iife --jsx=automatic --loader:.js=jsx --minify --define:process.env.NODE_ENV=\\\"production\\\" --outfile=www/app.js",
    "standalone": "npm run build && node scripts/standalone.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  }
}
